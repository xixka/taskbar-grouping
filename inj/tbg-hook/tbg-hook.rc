// tbg_hook resource script (task 34, follows the task-32 recipe verbatim).
//
// Compiled by rc.exe via winresource::set_resource_file (see build.rs).
// Plain ASCII, no code-page pragma. DLL edition: FILETYPE 0x2, no manifest
// (manifests are exe-side; embedding one in a DLL has no loader effect).
//
// Version sync: track the Cargo.toml [package] version (0.1.0 -> 0,1,0,0).

1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEOS          0x40004
FILETYPE        0x2
FILEFLAGSMASK   0x3f
FILEFLAGS       0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "CompanyName", "tbg-lite open-source project"
            VALUE "FileDescription", "tbg_hook - in-process AUMID interception library (route A)"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "tbg_hook"
            VALUE "LegalCopyright", "MIT License - https://github.com/xixka/taskbar-grouping"
            VALUE "OriginalFilename", "tbg_hook.dll"
            VALUE "ProductName", "tbg-lite"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0000, 0x04b0
    END
END

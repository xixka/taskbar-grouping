// tbg-inject resource script (task 35, follows the task-32 recipe verbatim).
//
// Compiled by rc.exe via winresource::set_resource_file (see build.rs).
// Plain ASCII, no code-page pragma. Exe edition: FILETYPE 0x1 + manifest.
//
// Version sync: track the Cargo.toml [package] version (0.1.0 -> 0,1,0,0).

#define RT_MANIFEST 24

1 VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEOS          0x40004
FILETYPE        0x1
FILEFLAGSMASK   0x3f
FILEFLAGS       0x0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "CompanyName", "tbg-lite open-source project"
            VALUE "FileDescription", "tbg-inject - taskbar grouping controller (injection edition)"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "tbg-inject"
            VALUE "LegalCopyright", "MIT License - https://github.com/xixka/taskbar-grouping"
            VALUE "OriginalFilename", "tbg-inject.exe"
            VALUE "ProductName", "tbg-lite"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0000, 0x04b0
    END
END

// Application manifest (resource ID 1 = CREATEPROCESS_MANIFEST_RESOURCE_ID).
// rc.exe resolves this quoted relative path against the build script's
// working directory, which is the package root.
1 RT_MANIFEST "tbg-inject.exe.manifest"
